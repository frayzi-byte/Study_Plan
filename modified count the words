while True:
    with open("C:\\Users\\andre\\Downloads\\Новая папка\\HZ.txt", 'r+', 'w') as file:
        inptt = input('Please write a command:\nFile read\nFile write\nFinish\n')

        if inptt == 'File read':
            file.seek(0)
            print(file.read())

        elif inptt == 'File write':
            text = input('Print a word that you want to add to the file:\n')
            file.seek(0, 2)
            file.write(' ' + text)
            text2 = input('Do you want to read a file that you have just changed?\n')
            if text2 == 'Yes':
                file.seek(0)
                print(file.read())
            elif text2 == 'No':
                exit()

        elif inptt == 'Finish':
            print('Goodbye!')
            exit()

        else:
            print("Unknown command, try again")

    
  
